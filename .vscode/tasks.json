{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kafka: iniciar (Docker Compose)",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "-d"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Kafka: parar (Docker Compose)",
      "type": "process",
      "command": "docker",
      "args": ["compose", "down"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
